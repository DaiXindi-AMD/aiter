+    _swiglu_bwd_kernel,
 )
 
 fp8_dtype = aiter.dtypes.fp8
@@ -307,3 +309,59 @@ def fused_silu_mul(
         waves_per_eu=0,
     )
     return out
+
+# ── Fused SwiGLU ─────────────────────────────────────────────────────────
+
+
+def _next_power_of_2(n: int) -> int:
+    n -= 1
+    n |= n >> 1
+    n |= n >> 2
+    n |= n >> 4
+    n |= n >> 8
+    n |= n >> 16
+    return n + 1
+
+
+def swiglu_fwd(y: torch.Tensor) -> torch.Tensor:
+    """Fused SwiGLU forward: silu(y1) * y2 where y is split along last dim.
+
+    Single Triton kernel replacing chunk → silu → mul (3+ kernel launches).
+    """
+    assert y.shape[-1] % 2 == 0
+    flat = y.reshape(-1, y.shape[-1])
+    rows = flat.shape[0]
+    half_cols = flat.shape[1] // 2
+
+    out = torch.empty(rows, half_cols, dtype=y.dtype, device=y.device)
+    BLOCK_SIZE = min(_next_power_of_2(half_cols), 65536)
+
+    _swiglu_fwd_kernel[(rows,)](
+        flat, out,
+        flat.stride(0), out.stride(0), half_cols,
+        BLOCK_SIZE=BLOCK_SIZE,
+    )
+    return out.reshape(*y.shape[:-1], half_cols)
+
+
+def swiglu_bwd(grad_output: torch.Tensor, y: torch.Tensor) -> torch.Tensor:
+    """Fused SwiGLU backward: computes gradient w.r.t. input y.
+
+    Single Triton kernel replacing chunk → sigmoid → mul → add → mul → silu → cat
+    (6-8 kernel launches).
+    """
+    assert y.shape[-1] % 2 == 0
+    flat_y = y.reshape(-1, y.shape[-1])
+    flat_g = grad_output.reshape(-1, grad_output.shape[-1])
+    rows = flat_y.shape[0]
+    half_cols = flat_y.shape[1] // 2
+
+    d_input = torch.empty_like(flat_y)
+    BLOCK_SIZE = min(_next_power_of_2(half_cols), 65536)
+
+    _swiglu_bwd_kernel[(rows,)](
+        flat_g, flat_y, d_input,
+        flat_g.stride(0), flat_y.stride(0), d_input.stride(0), half_cols,
+        BLOCK_SIZE=BLOCK_SIZE,
+    )
+    return d_input.reshape_as(y)
